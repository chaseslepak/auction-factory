ANTHROPIC_API_KEY=sk-ant-...
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
ALLOWED_EMAILS=chase.slepak@gmail.com,ashley@example.com,sierra@example.com

# Random secret used to authenticate Vercel cron + server-to-server calls to
# /api/jobs/process and /api/af-keepalive. Generate with `openssl rand -hex 32`.
# Set the same value in Vercel project env vars or cron jobs won't be able to
# trigger the processor.
CRON_SECRET=

# Sentry error tracking (optional). All Sentry init is guarded on presence of
# these vars, so leaving them blank is safe — the app just runs without error
# reporting. Get them from a free Sentry.io project.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
