{
  "manifest_version": 3,
  "name": "Crazy Good Buy — Marketplace Poster",
  "version": "0.1.0",
  "description": "Assisted posting of approved Crazy Good Buy listings to Facebook Marketplace. Pre-fills the form; you click Publish.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["https://www.facebook.com/*", "<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Crazy Good Buy Poster"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/marketplace/create/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
